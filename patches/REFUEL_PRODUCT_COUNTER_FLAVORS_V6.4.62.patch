+// Product signals use WooCommerce inventory and a short-lived count of active
+// browser tabs. Never fabricate inventory or a marketing viewer number.
+add_action('woocommerce_single_product_summary', function () {
+    global $product;
+    if (!$product || !in_array($product->get_type(), ['simple', 'variable'], true)) { return; }
+    $quantity = $product->is_type('simple') && $product->managing_stock() && !$product->backorders_allowed()
+        ? $product->get_stock_quantity() : null;
+    echo '<div class="refuel-product-signals" data-product-id="' . esc_attr($product->get_id()) . '" data-ajax-url="' . esc_url(admin_url('admin-ajax.php')) . '">';
+    echo '<p class="refuel-viewers" hidden aria-live="polite"><span aria-hidden="true">◉</span> <span class="refuel-viewer-number"></span> viewing this product now</p>';
+    echo '<div class="refuel-stock-signal" aria-live="polite"><strong class="refuel-stock-label">';
+    if (!$product->is_in_stock()) { echo 'Out of stock'; }
+    elseif (null !== $quantity) { echo esc_html($quantity <= 10 ? 'Only ' . max(0, $quantity) . ' left in stock' : $quantity . ' in stock'); }
+    elseif ($product->is_type('variable')) { echo 'Choose an option to check availability'; }
+    else { echo 'Available in shop'; }
+    echo '</strong><span class="refuel-stock-track"' . (null === $quantity ? ' hidden' : '') . '><span style="width:' . esc_attr(null === $quantity ? 0 : min(100, max(0, $quantity) * 5)) . '%"></span></span></div>';
+    echo '<button class="refuel-product-favourite" type="button" data-name="' . esc_attr(strtolower(trim($product->get_name()))) . '" aria-pressed="false"><span aria-hidden="true">♡</span> Save to favourites</button>';
+    echo '</div>';
+}, 11);
+
+add_action('wp_ajax_nopriv_refuel_product_presence', 'refuel_product_presence');
+add_action('wp_ajax_refuel_product_presence', 'refuel_product_presence');
+function refuel_product_presence() {
+    if (!function_exists('wc_get_product')) { wp_send_json_error('WooCommerce unavailable', 503); }
+    $id = isset($_POST['product_id']) ? absint(wp_unslash($_POST['product_id'])) : 0;
+    $visitor = isset($_POST['visitor']) ? sanitize_text_field(wp_unslash($_POST['visitor'])) : '';
+    if (!preg_match('/^[a-f0-9]{32}$/', $visitor)) { wp_send_json_error('Invalid visitor', 400); }
+    $product = wc_get_product($id);
+    if (!$product || 'publish' !== get_post_status($id) || !in_array($product->get_type(), ['simple', 'variable'], true)) {
+        wp_send_json_error('Product unavailable', 404);
+    }
+    $variation_id = isset($_POST['variation_id']) ? absint(wp_unslash($_POST['variation_id'])) : 0;
+    $stock_product = $variation_id ? wc_get_product($variation_id) : $product;
+    if (!$stock_product || ($variation_id && (!$stock_product->is_type('variation') || $stock_product->get_parent_id() !== $id))) {
+        wp_send_json_error('Invalid variation', 400);
+    }
+    $key = 'refuel_presence_' . $id;
+    $now = time();
+    $active = get_transient($key);
+    if (!is_array($active)) { $active = []; }
+    $active = array_filter($active, static function ($seen) use ($now) { return is_numeric($seen) && $seen > $now - 90; });
+    $active[$visitor] = $now;
+    if (count($active) > 250) { arsort($active); $active = array_slice($active, 0, 250, true); }
+    set_transient($key, $active, 120);
+    wp_send_json_success([
+        'viewers' => count($active),
+        'in_stock' => $stock_product->is_in_stock(),
+        'stock_quantity' => $stock_product->managing_stock() && !$stock_product->backorders_allowed()
+            ? $stock_product->get_stock_quantity() : null,
+    ]);
+}
